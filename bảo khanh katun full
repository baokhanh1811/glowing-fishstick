-- BUTTON
local function CreateBtn(text,pos)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(0,180,0,30)
    b.Position = pos
    b.Text = text
    return b
end

local BtnFarm = CreateBtn("Auto Farm: ON",UDim2.new(0,220,0,40))
BtnFarm.MouseButton1Click:Connect(function()
    Settings.AutoFarm = not Settings.AutoFarm
    BtnFarm.Text = "Auto Farm: "..(Settings.AutoFarm and "ON" or "OFF")
end)

-- EQUIP SAFE
function EquipWeapon()
    local char = GetChar()
    local hum = GetHum()

    for _,tool in pairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and string.find(tool.Name, Settings.Weapon) then
            hum:EquipTool(tool)
            return true
        end
    end

    for _,tool in pairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            hum:EquipTool(tool)
            return true
        end
    end
end

-- ENEMY SAFE
function GetEnemy()
    for _,v in pairs(workspace.Enemies:GetChildren()) do
        if v and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v.Humanoid.Health > 0 then
                return v
            end
        end
    end
end

-- SKILL COOLDOWN
local lastSkill = 0

function UseSkill()
    if not Settings.AutoSkill then return end
    if tick() - lastSkill < 1 then return end

    lastSkill = tick()

    for _,k in pairs({"Z","X","C","V"}) do
        VirtualUser:SendKeyEvent(true,k,false,game)
        task.wait(0.1)
        VirtualUser:SendKeyEvent(false,k,false,game)
    end
end

-- STAT SAFE
function AddStat()
    if not Settings.AutoStat then return end

    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("AddPoint",Settings.Weapon,1)
    end)
end

-- ATTACK (LOCK FIX)
function Attack(enemy)
    if Attacking then return end
    Attacking = true

    local start = tick()

    while Settings.AutoFarm do
        task.wait(0.25)

        if not enemy or not enemy.Parent then break end
        if not enemy:FindFirstChild("Humanoid") then break end
        if enemy.Humanoid.Health <= 0 then break end

        if tick() - start > 20 then break end

        local hrp = GetHRP()

        EquipWeapon()

        hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0,0,Settings.Distance)

        VirtualUser:ClickButton1(Vector2.new())

        UseSkill()
        AddStat()
    end

    Attacking = false
end

